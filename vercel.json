{
  "version": 2,
  "builds": [
    {
      "src": "api/ai_jumo.py", 
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/ai_jumo.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}